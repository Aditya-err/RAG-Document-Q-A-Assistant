# Copy this file to ".env" and fill in your actual key if you intend to use cloud models.
# Never commit the real .env file to git.
# Do NOT put real keys in this file.

# Optional: If you want to use Anthropic Claude (requires config.py change)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Supercompress API key
SUPERCOMPRESS_API_KEY=your_supercompress_key_here
